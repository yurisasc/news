    {
      "parameters": {
        "promptType": "define",
        "text": "=Role: You are an Indonesian News Strategy Specialist.\n\nTask: Analyze the provided news metadata (Headline/Snippet). Categorize each item and assign a Combined Priority Score (1-10).\n\nPriority Logic:\n\nLocal Weighting: Assign high scores (8-10) to news with direct impact on Indonesia (e.g., local policy, regional economy, national figures).\n\nGlobal Weighting: Assign high scores (8-10) to global news that directly affects Indonesia (e.g., ASEAN diplomacy, global tech shifts, international trade changes).\n\nIndonesian Perspective: For purely international stories, prioritize those with high interest for urban, globally-connected Indonesians (e.g., major geopolitical shifts, climate action, significant scientific breakthroughs).\n\nConstraint: Output ONLY valid JSON according to the schema. Do not include introductory text. Use clinical, neutral language.\n\nTitle: {{ $json.title }}\nURL: {{ $json.url }}\nContent: {{ $json.content }}",
        "hasOutputParser": true,
        "batching": {
          "batchSize": 10
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
      "position": [
        -256,
        512
      ],
      "id": "ec16d50b-f9d1-48c8-8b9a-2abf2a58a920",
      "name": "Classify"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 3
          },
          "conditions": [
            {
              "id": "22a4648d-ad2a-4c51-aa84-6e82feaf4ea4",
              "leftValue": "={{ $json.response.collection.name }}",
              "rightValue": "News",
              "operator": {
