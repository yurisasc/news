    {
      "parameters": {
        "jsCode": "const priorityData = $input.all(); // Data from the Classifier LLM\nconst rawArticles = $('Select important fields').all(); // Your raw news content\n\nconst grouped = {};\n\n// 1. Filter and Match\nrawArticles.forEach(article => {\n  const match = priorityData.find(p => p.json.output.id === article.json.url);\n  \n  // 2. Only proceed if priority is high (e.g., > 7)\n  if (match && match.json.output.priority > 7) {\n    const category = match.json.output.category;\n    \n    // 3. Group by Category\n    if (!grouped[category]) {\n      grouped[category] = {\n        category: category,\n        articles: []\n      };\n    }\n    \n    // Add the article and its AI-generated priority to the group\n    grouped[category].articles.push({\n      ...article.json,\n      priority: match.json.output.priority,\n      is_breaking: match.json.output.is_breaking\n    });\n  }\n});\n\n// Return as an array of groups for the \"Split in Batches\" or \"Loop\" node\nreturn Object.values(grouped);"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        288,
        720
      ],
      "id": "da3aaaec-3532-4efd-97b3-7a3496e5ae99",
      "name": "Filter and Group Priority News"
