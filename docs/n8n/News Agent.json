    {
      "parameters": {
        "promptType": "define",
        "text": "=Role: Neutral News Architect. Task: Synthesize the provided articles into unified \"Storylines.\" Operational Guideline: If articles conflict, state the discrepancy clearly (e.g., \"Source A reports X, Source B claims Y\"). Constraint: Do not add analysis. Ensure every storyline lists all its original source URLs.\n\nCategory: {{ $json.category }}\nArticles: {{ $json.articles.toJsonString() }}",
        "hasOutputParser": true,
        "batching": {
          "batchSize": 5
        }
      },
      "type": "@n8n/n8n-nodes-langchain.chainLlm",
      "typeVersion": 1.7,
