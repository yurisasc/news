        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"hero_section\": { \"$ref\": \"#/definitions/storyline\" },\n    \"at_a_glance\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"update\": { \n            \"type\": \"string\", \n            \"description\": \"One-sentence major update\" \n          },\n          \"sources\": {\n            \"type\": \"array\",\n            \"items\": { \"type\": \"string\", \"format\": \"uri\" },\n            \"description\": \"List of source URLs supporting this update\"\n          }\n        },\n        \"required\": [\"update\", \"sources\"]\n      }\n    },\n    \"categorized_sections\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"title\": { \"type\": \"string\" },\n          \"stories\": { \n            \"type\": \"array\", \n            \"items\": { \"$ref\": \"#/definitions/storyline\" } \n          }\n        },\n        \"required\": [\"title\", \"stories\"]\n      }\n    }\n  },\n  \"definitions\": {\n    \"storyline\": {\n      \"type\": \"object\",\n      \"properties\": {\n        \"headline\": { \"type\": \"string\" },\n        \"summary\": { \"type\": \"string\" },\n        \"takeaways\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\" }\n        },\n        \"sources\": {\n          \"type\": \"array\",\n          \"items\": { \"type\": \"string\", \"format\": \"uri\" }\n        }\n      },\n      \"required\": [\"headline\", \"summary\", \"takeaways\", \"sources\"]\n    }\n  }\n}",
